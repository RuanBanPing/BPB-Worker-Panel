    function renderLogs(items, isTelnet = false) {
        let total = 0, up = 0, down = 0, html = '';
        items.forEach(item => {
            if (!item) return;
            total++;
            
            const isUp = item.status === true && !String(item.detail || '').includes('正在握手');
            isUp ? up++ : down++;
            
            const stateClass = isUp ? 'state-online' : 'state-offline';
            const infoText = isTelnet ? `🔌 端口: <b>${item.host}:${item.port}</b> —— [反馈: ${item.msg}]` : `🌐 目标: <b>${item.host}</b> —— ${item.detail}`;
            const extraBadge = isTelnet ? '-' : `发送: ${item.sent_count ?? 0} 次 | 失败: ${item.loss_count ?? 0} 次`;
            
            html += `
                <div class="log-item ${stateClass}">
