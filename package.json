# --- 后端数据处理基础设施 ---

def strict_clean_host(raw_str):
    """提取纯IP/域名"""
    s = re.sub(r'^https?://', '', raw_str.strip(), flags=re.IGNORECASE)
    match = re.match(r'^([^:/\\\s]+)', s)
    return match.group(1).strip() if match else s

def ping_worker(original_host, target_ip):
    """终极主动式时钟级长 Ping 处理器"""
    is_win = platform.system().lower() == 'windows'
    
    # 初始化全局探测状态字典
    ping_status[original_host] = {
        "status": False, 
        "detail": "正在握手连接...", 
        "sent_count": 0,
        "loss_count": 0
    }
    
    # 注册一个标记，用于在外部发出 stop 指令时优雅安全地退出当前子线程
    ping_threads[original_host] = True
    t_reg = re.compile(r'time[=<](\d+\.?\d*\s*\w*)', re.I)
    
    # 核心：采用高频主动独立探针机制，不依赖长时间维持的长连接管道输出
    while original_host in ping_threads:
        # 单次按系统平台各发送1个包，超时设为0.8秒，快速收敛
        if is_win:
            cmd = ["ping", target_ip, "-n", "1", "-w", "800"]
        else:
            cmd = ["ping", target_ip, "-c", "1", "-W", "1"]
            
        try:
            # 增加发送计数
            with result_lock:
                ping_status[original_host]["sent_count"] += 1
                
            start_t = time.time()
            p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, shell=is_win)
            out, _ = p.communicate()
            encoding = 'gbk' if is_win else 'utf-8'
            
            try: res_str = out.decode(encoding).lower()
            except: res_str = out.decode('utf-8', errors='ignore').lower()
            
            with result_lock:
                stat = ping_status[original_host]
                if p.returncode == 0 and "ttl=" in res_str:
                    m = t_reg.search(res_str)
                    stat.update({
                        "status": True,
                        "detail": f"响应正常 (延迟: {m.group(1)})" if m else "网络通畅"
                    })
                else:
                    # 探测失败，失败数加 1
                    stat["status"] = False
                    stat["loss_count"] += 1
                    if any(k in res_str for k in ["timeout", "超时", "timed out"]):
                        stat["detail"] = "请求超时 (Request timed out...)"
                    elif any(k in res_str for k in ["unreachable", "不可达"]):
                        stat["detail"] = "目标主机不可达 (Host unreachable)"
                    else:
                        stat["detail"] = "请求超时 (Request timed out...)"
        except Exception as e:
            with result_lock:
                stat = ping_status[original_host]
                stat["status"] = False
                stat["loss_count"] += 1
                stat["detail"] = f"请求超时 (Request timed out...)"
                
        # 确保时钟步长平稳在1秒发送一次探测包（扣除探测消耗的时间）
        elapsed = time.time() - start_t
        sleep_time = max(0.1, 1.0 - elapsed)
        time.sleep(sleep_time)

# --- Flask 路由控制层 ---

@app.route('/')
def index():
    return render_template_string(HTML_TEMPLATE)

@app.route('/api/ping/start', methods=['POST'])
def start_ping():
    try:
        stop_all_pings()
        for host in request.json.get('hosts', []):
            if host.strip():
                Thread(target=ping_worker, args=(host, strict_clean_host(host)), daemon=True).start()
        return jsonify({"status": "success"})
    except Exception as e:
        return jsonify({"status": "error", "msg": str(e)})

@app.route('/api/ping/status', methods=['GET'])
def get_ping_status():
    return jsonify(ping_status)

@app.route('/api/ping/stop', methods=['POST'])
def stop_ping_api():
    stop_all_pings()
    return jsonify({"status": "success"})
def stop_all_pings():
    global ping_threads, ping_status
    ping_threads.clear()
    ping_status.clear()
    if platform.system().lower() == 'windows':
        subprocess.Popen("taskkill /f /im ping.exe", shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

@app.route('/api/exit_now', methods=['POST'])
def exit_now():
    print("\n[系统退出] 正在注销全部探测线程并回收系统资源...")
    stop_all_pings()
    # 核心微调：让后台在 0.2 秒后执行标准的系统退栈退出，从而触发 PyInstaller 绿色版的自删除清理钩子
    def gentle_exit():
        time.sleep(0.2)
        os._exit(0)
    Thread(target=gentle_exit, daemon=True).start()
    return jsonify({"status": "exiting"})

@app.route('/api/telnet', methods=['POST'])
def run_telnet():
    try:
        hosts = request.json.get('hosts', [])
        global_port = request.json.get('port', 80)
        results, threads = [], []

        def check_one(original_host):
            target_host = strict_clean_host(original_host)
            if not target_host: return
            
            port = global_port
            port_match = re.search(r':(\d+)$', original_host.strip())
            if port_match:
                port = int(port_match.group(1))

            now = time.strftime("%H:%M:%S")
            try:
                s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                s.settimeout(2.0)
                s.connect((target_host, port))
                s.close()
                res = {"host": target_host, "port": port, "status": True, "msg": "Open", "time": now}
            except:
                res = {"host": target_host, "port": port, "status": False, "msg": "Closed", "time": now}
            
            with result_lock:
                results.append(res)

        for h in hosts:
            t = Thread(target=check_one, args=(h,))
            threads.append(t)
            t.start()
            
        for t in threads: t.join()
        results.sort(key=lambda x: x['host'])
        return jsonify(results)
    except Exception as e:
        return jsonify([{"host": "Error", "port": 0, "status": False, "msg": str(e), "time": "00:00:00"}])

# --- 应用启动入口 ---

def start_flask():
    import logging
    logging.getLogger('werkzeug').setLevel(logging.ERROR)
    app.run(host='127.0.0.1', port=5000, debug=False, use_reloader=False)

if __name__ == '__main__':
    flask_thread = Thread(target=start_flask, daemon=True)
    flask_thread.start()
    time.sleep(0.5)

    url = "http://127.0.0.1:5000"
    sys_type = platform.system().lower()
    
    if sys_type == 'windows':
        paths = [r"C:\Program Files\Google\Chrome\Application\chrome.exe", r"C:\Program Files (x86)\Google\Chrome\Application\chrome.exe"]
        chrome_path = next((p for p in paths if os.path.exists(p)), None)
        chrome_cmd = [chrome_path, f"--app={url}", "--start-maximized"] if chrome_path else ["cmd", "/c", "start", "chrome", f"--app={url}", "--start-maximized"]
    elif sys_type == 'darwin':
        chrome_cmd = ["/Applications/Google Chrome.app/Contents/MacOS/Google Chrome", f"--app={url}", "--start-maximized"]
    else:
        chrome_cmd = ["google-chrome", f"--app={url}", "--start-maximized"]

    print("启动控制台...")
    try:
        subprocess.Popen(chrome_cmd)
    except:
        print(f"[提示] 请手动访问: {url}")

    flask_thread.join()
